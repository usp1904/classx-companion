# Server
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Security
ENABLE_HELMET=true
ENABLE_RATE_LIMIT=true

# AI Provider: stub | ollama | openrouter
AI_PROVIDER=stub
AI_ENABLE_CASCADE=true
AI_ENABLE_SEMANTIC_CACHE=true
AI_CACHE_MAX_ENTRIES=500
AI_CACHE_SIMILARITY=0.95

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_SMALL_MODEL=llama3.2:1b
OLLAMA_MEDIUM_MODEL=llama3.1:8b
OLLAMA_LARGE_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT_MS=30000

# OpenRouter (fallback)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# MCP connector
MCP_ENDPOINT=
MCP_API_KEY=
MCP_TIMEOUT_MS=10000

# KG connector
KG_ENDPOINT=
KG_API_KEY=
KG_TIMEOUT_MS=10000

# Content
CONTENT_ROOT=content

# Logging
LOG_LEVEL=info